{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bird-xai.local/schemas/interaction-event.schema.json",
  "title": "Bird XAI Interaction Event",
  "description": "Unity → Server: all client-to-server messages. Currently only controls.set.",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "message_type": { "type": "string", "const": "controls.set" },
    "overrides": {
      "type": "object",
      "propertyNames": { "$ref": "https://bird-xai.local/schemas/common.schema.json#/$defs/attributionFeatureKey" },
      "additionalProperties": { "type": "number" },
      "minProperties": 1
    }
  },
  "required": ["schema_version", "message_type", "overrides"],
  "additionalProperties": false
}
