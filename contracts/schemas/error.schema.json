{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bird-xai.local/schemas/error.schema.json",
  "title": "Bird XAI Error Message",
  "description": "Server → Unity: sent when the server encounters an error.",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "message_type": { "type": "string", "const": "error" },
    "code": {
      "type": "string",
      "enum": ["startup_error", "bad_request", "pipeline_error"]
    },
    "detail": { "type": "string" }
  },
  "required": ["schema_version", "message_type", "code", "detail"],
  "additionalProperties": false
}
