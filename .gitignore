# AI 모델 가중치 — bird_best.pt만 git (Railway Docker COPY)
ai/model/checkpoints/
ai/model/weights/
ai/training/model/weights/*
!ai/training/model/weights/bird_best.pt
*.ckpt

# 루트 임시 산출물 (실험 CSV·메모) — 실수 커밋 방지
/pred_*.csv
/true_*.csv

# Jupyter
.ipynb_checkpoints/
*.ipynb

# data/notebooks 안의 노트북은 예외
