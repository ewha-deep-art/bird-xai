# =====================
# Data (LFS 미사용 - 대용량 파일 제외)
# =====================

# data/raw/era5 폴더
data/raw/era5/**/*
!data/raw/era5/.gitkeep

# data/raw/era5_geese 폴더 (거위 ERA5 데이터)
data/raw/era5_geese/**/*
!data/raw/era5_geese/.gitkeep

# data/raw GPS 원본 CSV
data/raw/*.csv

# data/processed 대용량 파일
data/processed/*.csv
data/processed/*.nc
# 단, 샘플 파일은 예외
!data/processed/*_sample.csv

# =====================
# Python
# =====================
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.env
*.egg-info/
dist/
build/
.pytest_cache/

# AI 모델 가중치 (대용량)
ai/model/checkpoints/
ai/model/weights/
*.pt
*.pth
*.ckpt
*.pkl

# Jupyter
.ipynb_checkpoints/
*.ipynb

# data/notebooks 안의 노트북은 예외
!data/notebooks/*.ipynb

# =====================
# Unity
# =====================
render/Library/
render/Temp/
render/obj/
render/Build/
render/Builds/
render/Logs/
render/UserSettings/
render/*.suo
render/*.csproj
render/*.sln
render/.vs/
