# Bird XAI 환경변수 예시 — 실제 값은 .env 에 복사해 사용하세요 (`.env`는 커밋 금지).
# 모든 값은 선택사항이며, 미설정 시 ai/config.py 의 기본값이 적용됩니다.
# 현재 프로젝트는 외부 API 키·토큰·DB 접속정보 등 비밀값을 사용하지 않습니다.

# 서버 바인딩
BIRD_XAI_HOST=0.0.0.0
BIRD_XAI_PORT=8080            # Railway 등은 PORT 도 인식

# 프레임 스트림 주기(초)
BIRD_XAI_FRAME_INTERVAL=1.0

# 관람 입력(/wish) 제어
BIRD_XAI_WISH_RATE_LIMIT_SEC=5.0   # 동일 클라이언트 재전송 최소 간격(초)
BIRD_XAI_WISH_FLUSH_THRESHOLD=10   # 누적 메시지 수가 이 값에 도달하면 ws_850 override flush
